<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="#DDE3EC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pick_variant_title"
        android:textColor="@color/ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/pick_variant_hint"
        android:textColor="@color/ink_2"
        android:textSize="12sp" />

    <!-- 国内版选项 -->
    <LinearLayout
        android:id="@+id/option_cn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_variant_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/variant_cn"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pick_variant_cn_desc"
                android:textColor="@color/ink_2"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radio_cn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_radio_selected" />
    </LinearLayout>

    <!-- 国际版选项 -->
    <LinearLayout
        android:id="@+id/option_ai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_variant_unselected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/variant_ai"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pick_variant_ai_desc"
                android:textColor="@color/ink_2"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/radio_ai"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_radio_unselected" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary"
        android:text="@string/next_step"
        android:textColor="@color/brand_on_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:elevation="4dp" />
</LinearLayout>
